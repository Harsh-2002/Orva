# Build outputs
/orva
/orvad
/build/
/dist/
/out/

# The built dashboard. It is embedded via //go:embed, but it is a build
# artifact and it is not committed -- not one file. It used to be, on the
# argument that `make build` alone should reproduce a release artifact. It
# never did: release.yml, the Dockerfile and ci.yml all run the Vite build and
# then overwrite this directory, so the committed copy reached no shipped
# binary. What it did do was let `make build` serve a *stale* dashboard that
# looked plausible, silently, and put ~70 files of hashed-asset churn in the
# diff of every frontend PR.
#
# Two supported ways to get Orva: take a release binary, or build both halves
# yourself. `make build` does the second for you -- it builds the UI when this
# directory is empty.
backend/internal/server/ui_dist/

# Local agent / Claude session files
.claude/
.playwright-mcp/
*.session-transcript.txt
[0-9][0-9][0-9][0-9]-*-request-interrupted-by-user.txt
# Dated session-dump transcripts (e.g. 2026-04-23-144458-...txt)
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Go
*.test
*.out
*.prof
vendor/
# `go build ./test/...` drops the rehearsal harness binary at the repo root.
/migration-rehearsal

# Node — at any depth. The frontend is frontend/ (which has its own .gitignore
# for dist/ and logs); test/browser/ installs playwright-core locally.
node_modules/

# Python
**/__pycache__/

