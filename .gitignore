# Build outputs
/orva
/orvad
/build/
/dist/
/out/

# backend/internal/server/ui_dist/ is deliberately NOT ignored. The UI is
# embedded via //go:embed and the built snapshot is committed, so `make build`
# alone reproduces a release artifact (CONTRACT.md section 3). An earlier
# `internal/server/ui_dist/` entry here was dead -- it was missing the backend/
# prefix -- and "fixing" the path would have silently broken that invariant.

# Local agent / Claude session files
.claude/
.playwright-mcp/
*.session-transcript.txt
[0-9][0-9][0-9][0-9]-*-request-interrupted-by-user.txt
# Dated session-dump transcripts (e.g. 2026-04-23-144458-...txt)
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Go
*.test
*.out
*.prof
vendor/
# `go build ./test/...` drops the rehearsal harness binary at the repo root.
/migration-rehearsal

# Node — at any depth. The frontend is frontend/ (which has its own .gitignore
# for dist/ and logs); test/browser/ installs playwright-core locally.
node_modules/

# Python
**/__pycache__/

# Local data + secrets — should never be checked in
*.db
*.db-journal
*.db-wal
*.db-shm
.admin-key
/data/
orva-backup-*
*.tar.gz

# Test artifacts (point-in-time outputs from running harnesses — regenerable)
test/*.tsv
test/*.log
test/*-results.tsv
test/install/results-*.tsv
test/install/logs/*.log
test/install/logs/*.txt
test/install/logs/*.json
test/cli/logs/
test/kata-bench/runc/
test/kata-bench/kata/
test/kata-bench/kata-clh/
test/kata-bench/logs/
test/kata-bench/run.log
test/kata-bench/summary.md

# Design-tooling artifacts. design.json is the tracked design record; only the
# regenerable critique snapshots are ignored.
.impeccable/critique/

