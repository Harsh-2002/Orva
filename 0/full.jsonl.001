ailBin:     \"/usr/local/bin/nsjail\",\n\t\t\tRootfsDir:     filepath.Join(dataDir, \"rootfs\"),\n\t\t\tMaxConcurrent: maxConcurrentDefault(),\n\t\t\tSeccompPolicy: \"default\",\n\t\t},\n\t\tFunctions: FunctionsConfig{\n\t\t\tDefaultCPUs:    0.5,\n\t\t\tMaxCodeSize:    50 * 1024 * 1024, // 50MB\n\t\t\tDefaultMaxPids: 32,\n\t\t},\n\t\tLogging: LoggingConfig{\n\t\t\tLevel:  \"info\",\n\t\t\tFormat: \"json\",\n\t\t},\n\t\tSecurity: SecurityConfig{\n\t\t\tCORSOrigins: []string{\"*\"},\n\t\t\tSessionDays: 7,\n\t\t},\n\t\tData: DataConfig{\n\t\t\tDir: dataDir,\n\t\t},\n\t}\n}\ndocs/CONFIG.md:22:| `ORVA_PORT` | `8443` | Listen port — plain HTTP, no TLS. Set to `8080` when a reverse proxy owns 8443. |\ndocs/CONFIG.md:44:| Rootfs dir | `${ORVA_DATA_DIR}/rootfs` (derived) |\nbackend/internal/config/config.go:17:\t\"ORVA_PORT\",\nbackend/internal/config/config.go:59:\tRootfsDir     string\nbackend/internal/config/config.go:105:\t\tcfg.Sandbox.RootfsDir = v + \"/rootfs\"\nbackend/internal/config/config.go:114:\tif v := os.Getenv(\"ORVA_PORT\"); v != \"\" {\nbackend/internal/config/config.go:116:\t\t\tactive = append(active, \"ORVA_PORT\")\nbackend/internal/config/defaults.go:20:func defaultDataDir() string {\nbackend/internal/config/defaults.go:29:\tdataDir := defaultDataDir()\nbackend/internal/config/defaults.go:43:\t\t\tRootfsDir:     filepath.Join(dataDir, \"rootfs\"),\nbackend/internal/config/config_test.go:45:\t\t\"ORVA_PORT\":              true,\nbackend/internal/config/config_test.go:71:\t\"ORVA_PORT\":              \"7070\",\nbackend/internal/config/config_test.go:145:\tt.Setenv(\"ORVA_PORT\", \"7070\")\nbackend/internal/config/config_test.go:214:func TestLoadDataDirDerivedPaths(t *testing.T) {\nbackend/internal/config/config_test.go:229:\tif cfg.Sandbox.RootfsDir != \"/custom/data/rootfs\" {\nbackend/internal/config/config_test.go:230:\t\tt.Errorf(\"rootfs dir: want /custom/data/rootfs, got %s\", cfg.Sandbox.RootfsDir)\nbackend/internal/config/config_test.go:238:\tt.Se