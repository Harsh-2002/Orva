memory accounting reflects the new worker immediately. The\n   325\t\t\t// autoscaler does the same in scaleUp(); without it here, lazy\n   326\t\t\t// growth from cold traffic showed mem_reserved=0 for ~2s.\n   327\t\t\treservation := p.admissionBytes()\n   328\t\t\tif reservation > 0 && p.hostMem != nil {\n   329\t\t\t\tif !p.hostMem.reserve(reservation) {\n   330\t\t\t\t\treclaimed := p.reclaimFn != nil && p.reclaimFn()\n   331\t\t\t\t\tif !reclaimed || !p.hostMem.reserve(reservation) {\n   332\t\t\t\t\t\tp.spawning.Add(-1)\n   333\t\t\t\t\t\treturn nil, ErrMemoryExhausted\n   334\t\t\t\t\t}\n   335\t\t\t\t}\n   336\t\t\t}\n   337\t\t\tw, err := p.spawnFn(ctx)\n   338\t\t\tif err != nil {\n   339\t\t\t\tp.spawning.Add(-1)\n   340\t\t\t\tif reservation > 0 && p.hostMem != nil {\n   341\t\t\t\t\tp.hostMem.release(reservation)\n   342\t\t\t\t}\n   343\t\t\t\treturn nil, err\n   344\t\t\t}\n   345\t\t\tp.spawning.Add(-1)\n   346\t\t\tp.busy.Add(1)\n   347\t\t\tp.recordSpawn(time.Since(started))\n   348\t\t\tp.spawned.Add(1)\n   349\t\t\tp.workerReservations.Store(w, reservation)\n   350\t\t\t// Retirement may have happened while spawnFn was starting the\n   351\t\t\t// process. Never hand that stale worker to the caller; release its\n   352\t\t\t// accounting and let Manager.Acquire retry on the new generation.\n   353\t\t\tp.mu.Lock()\n   354\t\t\tretired := p.closing.Load()\n   355\t\t\tp.mu.Unlock()\n   356\t\t\tif retired {\n   357\t\t\t\tp.busy.Add(-1)\n   358\t\t\t\tp.killWorker(w)\n   359\t\t\t\treturn nil, errPoolRetired\n   360\t\t\t}\n   361\t\t\t// Count lazy growth as a scale-up event too. Operators watching the\n   362\t\t\t// autoscaler metric want \"how often did this pool grow\" — which\n   363\t\t\t// includes both the predictive scaler and request-path expansion.\n   364\t\t\tp.scaleUps.Add(1)\n   365\t\t\tstampAcquire(w)\n   366\t\t\treturn &AcquireResult{Worker: w, ColdStart: true}, nil\n   367\t\t}\n   368\t\n   369\t\t// At max — block until someone releases or ctx fires. ctx-fire here\n   370\t\t// specifically means \"the pool didn't free up in time\" — surface as\n   371\t\t// ErrPoolAtCapacity rather than the generic ctx err so the proxy can\n   372\t\t// distinguish it from per-fn TimeoutMS expiry (which fires on a\n   373\t\t// derived ctx and surfaces as ErrTimeout from Worker.Dispatch).\n   374\t\tselect {\n   375\t\tcase w := <-p.idle:\n   376\t\t\tif p.closing.Load() {\n   377\t\t\t\tp.killWorker(w)\n   378\t\t\t\treturn nil, errPoolRetired\n   379\t\t\t} else if p.isUnusable(w) {\n   380\t\t\t\tp.killWorker(w)\n   381\t\t\t\t// Recursive retry with same ctx — but avoid unbounded recursion\n   382\t\t\t\t// by just attempting to spawn once more if under max now.\n   383\t\t\t\treturn p.acquire(ctx)\n   384\t\t\t}\n   385\t\t\tp.busy.Add(1)\n   386\t\t\tstampAcquire(w)\n   387\t\t\treturn &AcquireResult{Worker: w, ColdStart: w.Served.Load() == 0}, nil\n   388\t\tcase <-p.retired:\n   389\t\t\treturn nil, errPoolRetired\n   390\t\tcase <-ctx.Done():\n   391\t\t\tp.capacityTimeouts.Add(1)\n   392\t\t\treturn nil, ErrPoolAtCapacity\n   393\t\t}\n   394\t}\n   395\t\n   396\t// markRetired closes the generation notification exactly once. Callers hold\n   397\t// p.mu so no worker can be published between the closing transition and the\n   398\t// idle drain performed by the manager.\n   399\tfunc (p *functionPool) markRetired() {\n   400\t\tp.closing.Store(true)\n","exit_code":0,"duration":{"secs":0,"nanos":20666},"formatted_output":"   255\t\tdefer p.sigMu.Unlock()\n   256\t\treturn int64(p.memUsedEWMA), p.cpuFracEWMA\n   257\t}\n   258\t\n   259\t// stampAcquire records the wall time and cumulative CPU usage on the worker\n   260\t// just before it is handed to a caller. The pool reads these back at release\n   261\t// to compute per-invocation resource EWMA metrics.\n   262\tfunc stampAcquire(w *sandbox.Worker) {\n   263\t\tw.AcquireAt = time.Now()\n   264\t\tw.AcquireUsec = sandbox.ReadCgroupCPUUs