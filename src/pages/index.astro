---
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Shot from '../components/Shot.astro';
import Brand from '../components/Brand.astro';

import systemOverview from '../assets/system-overview.png';
import functionEditor from '../assets/function-editor.png';
import functionConfig from '../assets/function-config.png';
import invocations from '../assets/invocations.png';
import deployments from '../assets/deployments.png';
import aiChat from '../assets/ai-chat.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/Harsh-2002/Orva';

// This page answers "what is this and why would I run it". It is not the
// documentation, and operational detail does not belong here: no config
// caveats, no API reference, no troubleshooting. A reader who has not decided
// yet should never meet a gotcha, and a reader who has decided is one click
// from /docs/, where every one of those details lives.
//
// Every claim below is derived from main, not from the previous copy on this
// page. The old page was written against pre-audit docs and inherited errors
// that the repository had already corrected, plus several it invented: a
// handler signature that does not exist, a licence that was never MIT, a
// compose port map that would have sent a reader to a dead port, and a
// --cap-add that had been deliberately removed upstream.

// Five layers, exactly as SECURITY.md's own diagram enumerates them. Network is
// deliberately NOT in this list: it is the one boundary that is a per-function
// setting rather than an invariant, so it is described on its own below.
const layers = [
  {
    n: '01',
    t: 'User namespace',
    d: 'Root inside the sandbox is not root on the host. The capability set is dropped before your code gets to run.',
  },
  {
    n: '02',
    t: 'Read-only root',
    d: 'The language runtime is mounted read-only, and nothing else on the host is visible from inside at all.',
  },
  {
    n: '03',
    t: 'Private filesystem',
    d: 'Your code is read-only. Scratch space is private to the sandbox and wiped the moment the worker exits, so nothing survives a call by accident.',
  },
  {
    n: '04',
    t: 'cgroup v2',
    d: "Memory, CPU and process limits are set per sandbox. A runaway handler spends its own budget, never the host's.",
  },
  {
    n: '05',
    t: 'seccomp allowlist',
    d: 'About <span class="num">150</span> syscalls are blocked outright, by the kernel, rather than by a check Orva performs and could get wrong.',
  },
];

const capabilities = [
  [
    'KV store',
    'Per-function key/value storage with optional expiry, in the same SQLite file as everything else. There is no Redis to run alongside it.',
  ],
  ['Function to function', 'Call one function from another directly, without the request leaving the box.'],
  ['Streaming', 'Send a response as it is produced instead of buffering the whole thing first.'],
  ['Background jobs', 'Move slow work off the request path and answer the caller immediately.'],
  ['Cron schedules', 'Run a function on a schedule, declared in code or set from the dashboard.'],
  ['Webhooks', 'Take signed deliveries from other systems, with verification handled for you.'],
  ['Traces', 'Follow one request across every function it touched, with timings and outliers marked.'],
  ['Invocation logs', "Each execution's request, response and log lines, kept for as long as you choose."],
  ['Activity feed', 'A running record of everything that touched the instance, and who did it.'],
  ['Deployments', 'Every version kept, with a diff against what is live and rollback in one click.'],
  ['Warm pools', 'Idle workers scaled to real demand, so the common path skips the cold start entirely.'],
  [
    'Egress control',
    'Outbound network is off until a function asks for it, and the policy lives with the sandbox.',
  ],
  ['API keys', 'Scoped keys you can hand to CI or to a person, and revoke one at a time.'],
  [
    'MCP server',
    '<span class="num">73</span> tools over Model Context Protocol, so an agent can operate the instance the way you would.',
  ],
  ['AI assistant', 'An assistant inside the dashboard driving those same tools, on your own provider keys.'],
];
---

<Layout
  title="Orva, self-hosted functions in a kernel sandbox"
  description="Self-hosted functions that run in a kernel sandbox. Node, Python and TypeScript on your own hardware, with five enforced boundaries per call. No control plane, no external database, no telemetry."
>
  <!-- 1. Hero ------------------------------------------------------------- -->
  <section class="section hero">
    <div class="container">
      <Brand />
      <h1 class="display hero__h">Functions that run in a kernel sandbox.</h1>
      <p class="lead hero__p">
        Orva deploys JavaScript, TypeScript and Python onto your own hardware and puts five kernel-enforced
        boundaries between each call and the host. Cold start is
        <span class="num">~50 to 500 ms</span>. A warm hit is <span class="num">~2 to 15 ms</span>
        and costs about <span class="num">18 MB</span> of resident memory.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#install">Get started</a>
        <a class="btn btn--secondary" href={`${base}/docs/`}>Read the docs</a>
      </div>

      <div class="hero__shot">
        <Shot
          src={systemOverview}
          alt="The Orva dashboard showing platform health, response time percentiles, host machine capacity, build activity and per-function warm pools."
          eager
        />
      </div>
    </div>
  </section>

  <!-- 2. What it is -------------------------------------------------------- -->
  <section class="section">
    <div class="container prose stack">
      <h2 class="eyebrow">What it is</h2>
      <p class="lead">
        A self-hosted function runtime for a homelab or a single on-premises box. You write a handler, Orva
        builds it, spawns it inside an <a class="link" href="https://github.com/google/nsjail">nsjail</a>
        sandbox and serves it over HTTP.
      </p>
      <p class="muted">
        There is no control plane to run, no external database and no telemetry. State lives in one SQLite
        file and a directory of function versions. It ships with a dashboard, a CLI, an MCP server and an AI
        assistant that operates the instance through the same API you do.
      </p>
    </div>
  </section>

  <!-- 3. Write ------------------------------------------------------------- -->
  <section class="section" id="write">
    <div class="container">
      <h2 class="eyebrow">Write</h2>
      <h3 class="sec__h">A handler, and nothing else to learn.</h3>
      <p class="lead prose sec__p">
        There are two runtimes, <span class="num">node</span> and <span class="num">python</span>, both
        latest-stable. TypeScript is a first-class path on <span class="num">node</span>: it compiles at build
        time and runs as JavaScript, so it is not a third runtime to operate.
      </p>

      <div class="two">
        <CodeBlock
          label="handler.js"
          lang="js"
          code={`exports.handler = async (event) => {
  // event.body is a raw string. Always parse it.
  const body = event.body ? JSON.parse(event.body) : {}

  return {
    statusCode: 200,
    headers: { 'Content-Type': 'application/json' },
    body: { hello: body.name || 'world' },
  }
}`}
        />
        <CodeBlock
          label="handler.py"
          lang="python"
          code={`import json


def handler(event):
    # event["body"] is a raw string. Always parse it.
    raw = event.get("body") or ""
    body = json.loads(raw) if raw else {}

    return {
        "statusCode": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {"hello": body.get("name", "world")},
    }`}
        />
      </div>

      <h3 class="sec__h sec__h--sub">The SDK is already there.</h3>
      <p class="lead prose sec__p">
        Storage, function-to-function calls, background jobs and schedules, importable from any handler.
        Nothing to install, nothing to wire up.
      </p>

      <div class="two">
        <CodeBlock
          label="KV, Node.js"
          lang="js"
          code={`const { kv } = require('orva')

exports.handler = async (event) => {
  await kv.put('user:42', { name: 'Ada' }, { ttlSeconds: 3600 })
  const user = await kv.get('user:42', null)

  return { statusCode: 200, body: JSON.stringify(user) }
}`}
        />
        <CodeBlock
          label="KV, Python"
          lang="python"
          code={`from orva import kv


def handler(event):
    # Python KV is synchronous.
    kv.put("user:42", {"name": "Ada"}, ttl_seconds=3600)
    user = kv.get("user:42", None)

    return {"statusCode": 200, "body": user}`}
        />
      </div>

      <div class="sec__shot">
        <Shot
          src={functionEditor}
          alt="The Orva function editor showing a Python handler that imports kv from the orva SDK, with a build and test panel below."
          caption="Write it, build it and test it without leaving the browser."
        />
      </div>
    </div>
  </section>

  <!-- 4. Isolation --------------------------------------------------------- -->
  <section class="section" id="isolation">
    <div class="container">
      <h2 class="eyebrow">Isolation</h2>
      <h3 class="sec__h">Five layers, all enforced by the kernel.</h3>
      <p class="lead prose sec__p">
        Orva configures the boundaries and trusts the kernel to hold them. The gaps between these layers are
        not enforced by Orva code.
      </p>

      <dl class="specs">
        {
          layers.map((l) => (
            <div class="spec">
              <dt class="spec__i">{l.n}</dt>
              <dt class="spec__t">{l.t}</dt>
              <dd class="spec__d" set:html={l.d} />
            </div>
          ))
        }
      </dl>

      <p class="muted prose sec__note">
        Network is the one boundary that is a setting rather than an invariant.
        <span class="num">none</span>, the default, is an isolated network namespace with loopback only. <span
          class="num">egress</span
        > opts a function into outbound traffic through a userspace network stack, where the blocklist is compiled
        into that sandbox's own configuration. No host firewall table is ever created.
      </p>

      <div class="sec__shot">
        <Shot
          src={functionConfig}
          alt="The Orva function configuration dialog showing runtime, memory, CPU, concurrency, the outbound network toggle and the invoke gate."
          caption="Outbound network is off until a function opts in."
        />
      </div>
    </div>
  </section>

  <!-- 5. Operate ----------------------------------------------------------- -->
  <section class="section" id="operate">
    <div class="container">
      <h2 class="eyebrow">Operate</h2>
      <h3 class="sec__h">What you get with it.</h3>

      <dl class="specs specs--tight">
        {
          capabilities.map(([t, d], i) => (
            <div class="spec">
              <dt class="spec__i">{String(i + 1).padStart(2, '0')}</dt>
              <dt class="spec__t">{t}</dt>
              <dd class="spec__d" set:html={d} />
            </div>
          ))
        }
      </dl>

      <div class="two two--shots">
        <Shot
          src={invocations}
          alt="The Orva invocations view listing executions with function name, status, cold-start flag, HTTP code, duration and trace ID."
          caption="Every execution, with its trace."
        />
        <Shot
          src={deployments}
          alt="The Orva deployments view showing version history for a function with the live version marked and rollback available per version."
          caption="Every version kept, with rollback."
        />
      </div>

      <div class="sec__shot">
        <Shot
          src={aiChat}
          alt="The Orva chat assistant answering a question about warm pool usage per function by calling the system metrics tool."
          caption="The assistant drives the same tools the API exposes."
        />
      </div>
    </div>
  </section>

  <!-- 6. What it isn't ----------------------------------------------------- -->
  <section class="section" id="limits">
    <div class="container">
      <h2 class="eyebrow">What it is not</h2>
      <h3 class="sec__h">The honest boundary.</h3>

      <dl class="specs">
        <div class="spec">
          <dt class="spec__i">01</dt>
          <dt class="spec__t">Not multi-tenant</dt>
          <dd class="spec__d">
            Orva is single-tenant by design. Every function on an instance shares one host and one trust
            boundary. It is not built to run code from people you do not trust.
          </dd>
        </div>
        <div class="spec">
          <dt class="spec__i">02</dt>
          <dt class="spec__t">Not a defence against kernel zero-days</dt>
          <dd class="spec__d">
            No seccomp filter is bulletproof. The threat model is explicit that a kernel-level zero-day, and
            side-channel attacks generally, are out of scope.
          </dd>
        </div>
        <div class="spec">
          <dt class="spec__i">03</dt>
          <dt class="spec__t">Not a managed platform</dt>
          <dd class="spec__d">
            There is no hosted control plane, no SLA and no one on call but you. That is the point, and it is
            also the cost.
          </dd>
        </div>
        <div class="spec">
          <dt class="spec__i">04</dt>
          <dt class="spec__t">Not a horizontal cluster</dt>
          <dd class="spec__d">
            One node, one SQLite file. Measured on a 2-CPU, 12 GB host it sustains roughly
            <span class="num">880 req/s</span> under heavy concurrency, and sheds the excess rather than falling
            over.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 7. Install ----------------------------------------------------------- -->
  <section class="section" id="install">
    <div class="container">
      <h2 class="eyebrow">Install</h2>
      <h3 class="sec__h">However you already run things.</h3>
      <p class="lead prose sec__p">
        One container, one volume, one port. The image carries the sandbox runtime with it, so there is
        nothing to install on the host alongside it.
      </p>

      <ol class="ways">
        <li class="way">
          <span class="way__i">01</span>
          <div class="way__label">
            <h4 class="way__h">Compose</h4>
            <p class="way__d">
              The short path. Dashboard on <span class="num">localhost:3000</span>.
            </p>
          </div>
          <div class="way__code">
            <CodeBlock
              label="bash"
              code={`$ curl -fsSL ${'https://raw.githubusercontent.com/Harsh-2002/Orva/main/docker-compose.yml'} -o docker-compose.yml
$ docker compose up -d
# http://localhost:3000`}
            />
          </div>
        </li>

        <li class="way">
          <span class="way__i">02</span>
          <div class="way__label">
            <h4 class="way__h">Docker</h4>
            <p class="way__d">The same image, without a Compose file.</p>
          </div>
          <div class="way__code">
            <CodeBlock
              label="bash"
              code={`$ docker run -d --name orva -p 8443:8443 \\
    --pid host --cgroupns host \\
    --cap-add SYS_ADMIN \\
    --security-opt seccomp=unconfined \\
    --security-opt apparmor=unconfined \\
    --security-opt systempaths=unconfined \\
    --device /dev/net/tun \\
    -v orva-data:/var/lib/orva \\
    -v /sys/fs/cgroup:/sys/fs/cgroup:rw \\
    ghcr.io/harsh-2002/orva:latest`}
            />
          </div>
        </li>

        <li class="way">
          <span class="way__i">03</span>
          <div class="way__label">
            <h4 class="way__h">Bare metal</h4>
            <p class="way__d">A service, from a checksum-verified download.</p>
          </div>
          <div class="way__code">
            <CodeBlock
              label="bash"
              code={`$ curl -fsSL ${'https://github.com/Harsh-2002/Orva/releases/latest/download/install.sh'} | sh`}
            />
          </div>
        </li>

        <li class="way">
          <span class="way__i">04</span>
          <div class="way__label">
            <h4 class="way__h">CLI only</h4>
            <p class="way__d">Just the client, for an instance you already run.</p>
          </div>
          <!-- One block per platform. A single block would have put a shell
               command and a PowerShell command behind one Copy button, and
               whichever you are on, you would get both. -->
          <div class="way__code way__code--split">
            <CodeBlock
              label="macOS, Linux"
              code={`$ curl -fsSL ${'https://github.com/Harsh-2002/Orva/releases/latest/download/install-cli.sh'} | sh`}
            />
            <CodeBlock
              label="Windows"
              code={`$ irm ${'https://github.com/Harsh-2002/Orva/releases/latest/download/install-cli.ps1'} | iex`}
            />
          </div>
        </li>
      </ol>

      <div class="closing">
        <h3 class="sec__h">Deploy something.</h3>
        <p class="lead prose">
          Point the CLI at your instance once, then it is three lines to a live endpoint.
        </p>
        <div class="closing__code">
          <CodeBlock
            label="bash"
            code={`$ orva deploy ./hello --name hello --runtime python
$ orva invoke hello --body '{"name":"Ada"}'
{"hello":"Ada"}`}
          />
        </div>
        <div class="hero__cta">
          <a class="btn btn--primary" href={`${base}/docs/`}>Read the docs</a>
          <a class="btn btn--secondary" href={repo}>View source</a>
        </div>
        <p class="muted prose closing__note">
          Configuration, the full SDK surface, the security model and the things worth knowing before your
          first deploy are all in the
          <a class="link" href={`${base}/docs/`}>documentation</a>.
        </p>
      </div>

      <!-- Where the licence, the source and the invitation to contribute live,
           now that the page has no footer to put them in. -->
      <div class="oss">
        <h2 class="eyebrow">Open source</h2>
        <h3 class="sec__h">Apache 2.0, and yours to change.</h3>
        <p class="lead prose sec__p">
          The runtime, the dashboard, the CLI and the MCP server are one repository. Read it, fork it, run it
          for as long as you like without asking anyone. Issues and pull requests are welcome, and so is
          telling us where the documentation is wrong.
        </p>

        <dl class="specs oss__list">
          <div class="spec">
            <dt class="spec__i">01</dt>
            <dt class="spec__t">Read the source</dt>
            <dd class="spec__d">
              Go, Vue and one SQLite file. <a class="link" href={repo}>Harsh-2002/Orva</a>
            </dd>
          </div>
          <div class="spec">
            <dt class="spec__i">02</dt>
            <dt class="spec__t">Report something</dt>
            <dd class="spec__d">
              A bug, a rough edge, or a number on this page that is wrong.
              <a class="link" href={`${repo}/issues`}>Open an issue</a>
            </dd>
          </div>
          <div class="spec">
            <dt class="spec__i">03</dt>
            <dt class="spec__t">Licence</dt>
            <dd class="spec__d">
              Apache 2.0, patent grant included.
              <a class="link" href={`${repo}/blob/main/LICENSE`}>Read it</a>
            </dd>
          </div>
        </dl>

        <div class="hero__cta">
          <a class="btn btn--secondary" href={repo}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            View on GitHub
          </a>
          <a class="btn btn--secondary" href={`${repo}/blob/main/CHANGELOG.md`}>Changelog</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: var(--v-6);
  }

  .hero__h {
    max-width: 16ch;
    margin-top: var(--v-6);
  }

  .hero__p {
    max-width: 54ch;
    margin-top: var(--v-2);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--v-1);
    margin-top: var(--v-3);
  }

  .hero__shot {
    margin-top: var(--v-6);
  }

  .sec__h {
    margin-top: var(--v-1);
    max-width: 20ch;
  }

  .sec__h--sub {
    margin-top: var(--v-8);
  }

  .sec__p {
    margin-top: var(--v-2);
  }

  .sec__note {
    margin-top: var(--v-2);
    font-size: var(--t-small);
  }

  /* Supporting shots run 18 of 24 columns, centred. The hero keeps the full
     24, because it is the hero.

     This is rhythm rather than economy: five identical full-bleed slabs read as
     a gallery, and a gallery is the shape you choose before you know what the
     images are. It also lowers the page by about 600px and gives the captures'
     own busy wallpaper less of the viewport to shout from. */
  .sec__shot {
    margin-top: var(--v-4);
    max-width: calc(18 * var(--pitch) - var(--g));
    margin-inline: auto;
  }

  .two {
    display: grid;
    /* minmax(0, ...) or a long line inside a scrolling <pre> sizes this track
       to its max-content and drags the whole page wider. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--v-2);
    margin-top: var(--v-3);
  }

  @media (min-width: 64rem) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .two--shots {
    margin-top: var(--v-4);
  }

  .specs {
    margin-top: var(--v-3);
    border-bottom: 1px solid var(--bd-hair);
  }

  .specs :global(.spec:last-child) {
    border-bottom: none;
  }

  /* Rows, not a 2x2 of cards.

     As a grid the four panels were equal-height boxes holding code blocks of
     125px to 301px, bottom-aligned by margin-top:auto. Measured, the dead space
     above each snippet came out at 144px, 11px, 55px and 11px. Nothing was
     broken; it just looked it, because the boxes were forced to agree on a
     height while their contents could not.

     Rows drop the constraint. Each one is as tall as its own command, and what
     repeats is the structure: index, label, code, hairline. That is the same
     rhythm as the isolation and capability lists further up, so the install
     section stops being the one part of the page built out of cards. */
  .ways {
    margin-top: var(--v-3);
    border-bottom: 1px solid var(--bd-hair);
  }

  .way {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    column-gap: var(--g);
    align-items: start;
    padding-block: var(--v-2);
    border-top: 1px solid var(--bd-hair);
  }

  .way__i {
    grid-column: span 2;
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    /* Nudged onto the heading's baseline rather than the row's top edge. */
    padding-top: 0.35em;
  }

  .way__label {
    grid-column: span 6;
    padding-top: 0.1em;
  }

  .way__h {
    font-size: var(--t-body);
    font-weight: 600;
  }

  .way__d {
    margin-top: var(--v-0);
    font-size: var(--t-small);
    color: var(--ink-2);
    max-width: 30ch;
  }

  .way__code {
    grid-column: span 16;
    min-width: 0;
  }

  .way__code--split {
    display: grid;
    gap: var(--v-1);
  }

  @media (max-width: 63.99rem) {
    .way {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      row-gap: var(--v-1);
    }
    .way__i {
      grid-column: 1;
      grid-row: 1;
    }
    .way__label {
      grid-column: 2;
      grid-row: 1;
    }
    .way__code {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .closing {
    margin-top: var(--v-8);
    padding-top: var(--v-6);
    border-top: 1px solid var(--bd-hair);
  }

  .closing__code {
