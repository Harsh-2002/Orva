---
import '../styles/global.css';
import ThemeDock from '../components/ThemeDock.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const baseTrim = base.replace(/\/$/, '');

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  noindex = false,
  description = 'Self-hosted functions that run in a kernel sandbox. Node, Python and TypeScript on your own hardware, with five enforced boundaries per call. No control plane, no external database, no telemetry.',
} = Astro.props;

const site = Astro.site ?? new URL('https://harsh-2002.github.io/');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`${baseTrim}/og.png`, site).href;

const ldJson = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      url: canonical,
      name: 'Orva',
      description,
      inLanguage: 'en',
      publisher: { '@id': `${canonical}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${canonical}#person`,
      name: 'Harsh',
      url: 'https://github.com/Harsh-2002',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Orva',
      description,
      url: canonical,
      image: ogImage,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Serverless Runtime',
      operatingSystem: 'Linux',
      // Apache-2.0. The repository LICENSE has always been Apache 2.0; this
      // field said MIT, and unlike the prose on the page it is machine-readable
      // and gets indexed as a fact about the project.
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      author: { '@id': `${canonical}#person` },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      programmingLanguage: ['JavaScript', 'TypeScript', 'Python'],
      codeRepository: 'https://github.com/Harsh-2002/Orva',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!--
      Theme resolution, before anything paints. is:inline keeps Astro from
      hoisting or bundling this: it has to execute synchronously, in the head,
      or the page paints in the wrong theme and then corrects itself.
    -->
    <script is:inline>
      (function () {
        const r = document.documentElement;
        try {
          const p = localStorage.getItem('orva-theme') || 'system';
          r.dataset.themePref = p;
          r.dataset.theme =
            p === 'dark' || (p === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
              ? 'dark'
              : 'light';
        } catch {
          // localStorage throws outright in some privacy modes. Dark is the
          // safer default to paint: a flash to light hurts more at night.
          r.dataset.theme = 'dark';
          r.dataset.themePref = 'system';
        }
      })();
    </script>

    <meta name="description" content={description} />

    <!--
      color-scheme is what makes native scrollbars, form controls and the UA's
      own canvas correct during load and after a toggle. The meta covers the
      window before CSS arrives; the CSS property covers the override case.
    -->
    <meta name="color-scheme" content="light dark" />

    <!--
      Two media-scoped theme-color tags for the pre-JS and system case. They are
      WRONG the moment a user overrides to light on a system-dark phone, so the
      toggle swaps them for a single unscoped tag whenever the preference is not
      'system', and restores the pair when it returns to System.
    -->
    <meta name="theme-color" content="#F8F7F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0D0A" media="(prefers-color-scheme: dark)" />

    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Harsh" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />

    <meta name="apple-mobile-web-app-title" content="Orva" />
    <meta name="format-detection" content="telephone=no" />

    <!--
      No *-web-app-capable here, deliberately. Those two declare standalone
      launch, and a reader who adds a docs site to their home screen then gets
      it with no back button and no address bar: every outbound link, and there
      are several to GitHub, becomes a dead end.

      It also mattered for the toolbar colour specifically. In standalone mode
      iOS takes its status bar from apple-mobile-web-app-status-bar-style
      rather than from theme-color, and with no such tag it defaults to dark
      text on white, which is wrong the moment the page is in dark mode. Not
      declaring standalone removes the whole failure mode instead of patching
      it with a third tag that can drift from the other two.
    -->

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Orva" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Orva, self-hosted functions in a kernel sandbox" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href={`${baseTrim}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${baseTrim}/favicon.svg`} />

    <script type="application/ld+json" set:html={JSON.stringify(ldJson)} is:inline />
  </head>

  <body>
    <span id="top" aria-hidden="true"></span>
    <a class="skip" href="#main">Skip to content</a>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <ThemeDock />

    <script>
      // ----------------------------------------------------------------------
      // Theme
      // ----------------------------------------------------------------------
      const root = document.documentElement;
      const KEY = 'orva-theme';
      const mq = matchMedia('(prefers-color-scheme: dark)');

      const resolve = (pref: string) =>
        pref === 'dark' || (pref === 'system' && mq.matches) ? 'dark' : 'light';

      function syncThemeColor(pref: string, theme: string) {
        const head = document.head;
        head.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.remove());

        const add = (content: string, media?: string) => {
          const m = document.createElement('meta');
          m.name = 'theme-color';
          m.content = content;
          if (media) m.media = media;
          head.appendChild(m);
        };

        if (pref === 'system') {
          // Let the OS decide, the same way the server-rendered pair does.
          add('#F8F7F4', '(prefers-color-scheme: light)');
          add('#0E0D0A', '(prefers-color-scheme: dark)');
        } else {
          // An explicit choice must win over the OS, so the tag cannot be
          // media-scoped: a scoped light tag on a system-dark phone loses.
          add(theme === 'dark' ? '#0E0D0A' : '#F8F7F4');
        }
      }

      function apply(pref: string, animate = true) {
        const theme = resolve(pref);
        if (animate) {
          // A 140ms cross-fade of an entire page reads as a rendering fault.
          // Kill every transition for the single frame of the swap.
          root.classList.add('theme-switching');
          requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
        }
        root.dataset.themePref = pref;
        root.dataset.theme = theme;
        syncThemeColor(pref, theme);

        document.querySelectorAll<HTMLElement>('[data-theme-opt]').forEach((b) => {
          const on = b.dataset.themeOpt === pref;
          b.setAttribute('aria-checked', String(on));
          b.tabIndex = on ? 0 : -1;
        });
      }

      document.querySelectorAll<HTMLElement>('[data-theme-opt]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const pref = btn.dataset.themeOpt!;
          try {
            localStorage.setItem(KEY, pref);
          } catch {
            /* private mode: the choice just does not persist */
          }
          apply(pref);
        });
      });

      // Arrow-key navigation within each radiogroup.
      document.querySelectorAll<HTMLElement>('[data-theme-group]').forEach((group) => {
        group.addEventListener('keydown', (e) => {
          const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'];
          if (!keys.includes(e.key)) return;
          e.preventDefault();
          const opts = [...group.querySelectorAll<HTMLElement>('[data-theme-opt]')];
          const i = opts.findIndex((o) => o.getAttribute('aria-checked') === 'true');
          const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
          const next = opts[(i + d + opts.length) % opts.length];
          next.click();
          next.focus();
        });
      });

      // A System user's page follows the OS live, with no reload.
      mq.addEventListener('change', () => {
        if ((root.dataset.themePref || 'system') === 'system') apply('system');
      });

      apply(root.dataset.themePref || 'system', false);

      // ----------------------------------------------------------------------
      // Copy buttons
      // ----------------------------------------------------------------------
      // navigator.clipboard exists only in a secure context: https, or
      // localhost. It is undefined on a plain-http LAN origin, which is exactly
      // how this site gets reviewed before it ships, and how it would be served
      // by anyone running Orva on their own box without TLS in front of it.
      //
      // So there is a fallback, and every path reports back. The original
      // version called writeText unconditionally and swallowed the TypeError,
      // which meant the button did nothing at all and said nothing about it.
      async function writeClipboard(text: string): Promise<boolean> {
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            /* fall through to the selection path below */
          }
        }
        // execCommand is deprecated and is still the only thing that works on
        // an insecure origin. It needs a real, focusable, on-screen element:
        // display:none or visibility:hidden will not select.
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;padding:0;border:0;opacity:0;';
          document.body.appendChild(ta);
          ta.select();
          ta.setSelectionRange(0, ta.value.length);
          const ok = document.execCommand('copy');
          ta.remove();
          return ok;
        } catch {
          return false;
        }
      }

      document.querySelectorAll<HTMLElement>('[data-copy]').forEach((btn) => {
        const original = btn.textContent || 'Copy';
        let timer: ReturnType<typeof setTimeout> | undefined;

        btn.addEventListener('click', async () => {
          const block = btn.closest('.code')?.querySelector('pre');
          if (!block) return;

          const ok = await writeClipboard(block.innerText.trim());

          clearTimeout(timer);
          btn.dataset.copied = ok ? 'true' : 'false';
          btn.dataset.failed = ok ? 'false' : 'true';
          btn.textContent = ok ? 'Copied' : 'Press Ctrl+C';
          // Announce it, because a sighted user sees the label change and a
          // screen-reader user otherwise gets nothing at all.
          btn.setAttribute('aria-live', 'polite');

          timer = setTimeout(
            () => {
              btn.dataset.copied = 'false';
              btn.dataset.failed = 'false';
              btn.textContent = original;
            },
            ok ? 1400 : 2600
          );
        });
      });
    </script>
  </body>
</html>
